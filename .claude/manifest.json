{
  "name": "k8squest",
  "description": "Learn Kubernetes by fixing it — a local, game-style troubleshooting trainer with 50 levels across 5 worlds",
  "version": "1.0",
  "entrypoints": {
    "setup": "./install.sh",
    "play": "./play.sh",
    "reset": "python engine/reset.py"
  },
  "requirements": {
    "system": [
      "Docker Desktop (running)",
      "kubectl",
      "kind or k3s",
      "jq",
      "bash"
    ],
    "python": {
      "version": "3.9+",
      "packages": [
        "rich",
        "pyyaml"
      ]
    }
  },
  "directories": {
    "engine": "Game engine (engine.py, reset.py, safety.py, retro_ui.py, player_name.py, certificate.py)",
    "worlds": "50 levels organized into 5 worlds of 10 levels each",
    "docs": "Documentation and guides",
    "tools": "Level scaffolding and generation scripts",
    "utils": "Testing and auditing utilities",
    "rbac": "RBAC manifests to limit player access to k8squest namespace",
    "certificates": "Sample completion certificates",
    "tests": "Test suites (e.g., test_safety.py)"
  },
  "worlds": [
    {
      "number": 1,
      "name": "Basics",
      "levels": 10,
      "topics": [
        "Pods",
        "Image pull",
        "Labels",
        "Ports",
        "Logs",
        "Init containers",
        "Multi-container pods",
        "Namespaces",
        "Deployments basics"
      ]
    },
    {
      "number": 2,
      "name": "Deployments",
      "levels": 10,
      "topics": [
        "Rollbacks",
        "Liveness probes",
        "Readiness probes",
        "HPA (Horizontal Pod Autoscaling)",
        "Rollout strategies",
        "PDB (Pod Disruption Budgets)",
        "Blue/green deployments",
        "Canary deployments",
        "StatefulSet",
        "ReplicaSet"
      ]
    },
    {
      "number": 3,
      "name": "Networking",
      "levels": 10,
      "topics": [
        "Service selectors",
        "NodePort",
        "DNS resolution",
        "Ingress",
        "NetworkPolicy",
        "Session affinity",
        "Cross-namespace networking",
        "Endpoints",
        "LoadBalancer",
        "Headless services"
      ]
    },
    {
      "number": 4,
      "name": "Storage",
      "levels": 10,
      "topics": [
        "PVC pending states",
        "Volume mounts",
        "Access modes",
        "StatefulSet volumes",
        "StorageClass",
        "ConfigMaps",
        "Secrets (encoding)",
        "Volume permissions",
        "Reclaim policies",
        "emptyDir vs PVC"
      ]
    },
    {
      "number": 5,
      "name": "Security and Scheduling",
      "levels": 10,
      "topics": [
        "RBAC (Role-Based Access Control)",
        "securityContext",
        "ResourceQuota",
        "NetworkPolicy (advanced)",
        "Node affinity",
        "Taints and tolerations",
        "PDB (Pod Disruption Budgets)",
        "Pod Security standards",
        "PriorityClass",
        "Chaos finale (9 simultaneous failures)"
      ]
    }
  ],
  "level_structure": {
    "example_path": "worlds/world-1-basics/level-8-logs/",
    "files": {
      "mission.yaml": "Level metadata (name, description, XP, difficulty, concepts)",
      "broken.yaml": "The faulty manifest (starting state)",
      "solution.yaml": "The fixed manifest (for reference)",
      "validate.sh": "Pass/fail check (exits 0 if correct)",
      "hint-1.txt": "First hint (progressive unlock)",
      "hint-2.txt": "Second hint",
      "hint-3.txt": "Third hint",
      "debrief.md": "Post-win explanation with mental models and interview Q&A",
      "common-mistakes.md": "Optional file with common errors to avoid"
    }
  },
  "engine": {
    "main_file": "engine/engine.py",
    "lines_of_code": 1583,
    "lifecycle": {
      "deploy": "engine.py ~line 864 — wipes namespace and applies broken.yaml",
      "validate": "engine.py ~line 967 — runs validate.sh, exit 0 = pass",
      "reset": "engine/reset.py — re-applies broken state",
      "progress": "progress.json — saves total_xp, completed_levels, current_world, current_level, player_name"
    }
  },
  "cluster_config": {
    "default": {
      "type": "kind",
      "cluster_name": "k8squest",
      "context": "kind-k8squest"
    },
    "alternatives": {
      "k3s": {
        "env_var": "K8S_CLUSTER_TYPE=k3s",
        "kubeconfig": "~/.kube/k3s-config",
        "context": "k3s-k8squest"
      }
    },
    "unsupported": [
      "minikube"
    ]
  },
  "commands": {
    "in_game": [
      "check — live view of resources",
      "hints — unlock progressive hints (max 3)",
      "solution — view the fixed manifest",
      "validate — check if fix is correct",
      "skip — move to next level",
      "quit — exit game"
    ]
  },
  "features": {
    "debrief_review": "Post-win explanation with real-world context and interview Q&A",
    "player_names": "DevOps-themed generated names (e.g., SwiftSRE)",
    "progress_tracking": "Auto-saved to progress.json; can resume later",
    "completion_certificates": "Issued when world is finished",
    "safety_guards": "Protects system namespaces and blocks destructive operations",
    "rbac_limited": "Player confined to k8squest namespace"
  },
  "hosting": {
    "docker": {
      "image": "mmengineer42/k8squest",
      "registry": "Docker Hub",
      "platform": "iximiuz Labs",
      "dockerfile_base": "python:3.11-slim",
      "kubectl_version": "1.31.4"
    }
  },
  "total_xp": 10200,
  "total_levels": 50
}
